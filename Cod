# Função para tratar valores ausentes ou não informados e aplicar substituições específicas
def tratar_colunas(coluna):
    def ajustar_valor(x):
        if isinstance(x, str):
            valores = [campo.strip() for campo in re.split(r'[,/]', x)]  # Divide por "," ou "/"
            valores_ajustados = []
            for campo in valores:
                if campo.upper() in ['-', '-NÃO INFORMADO-']:
                    valores_ajustados.append('Não Informado')
                elif campo.upper() == 'R':
                    valores_ajustados.append('RUBY')
                elif campo.upper() == 'C':
                    valores_ajustados.append('C#')
                elif campo.upper() in ['JAVASCRIPT', 'JAVA SCRIPT','JAVASCRIPY']:
                    valores_ajustados.append('JAVASCRIPT')
                else:
                    valores_ajustados.append(campo)
            return valores_ajustados
        else:
            return none
    return coluna.apply(ajustar_valor)
