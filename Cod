# Função para contar a ocorrência de cada valor em uma coluna específica
def contar_ocorrencias(dataframe, coluna):
    ocorrencias = {}
    for valores in dataframe[coluna]:
        for valor in valores:
            if valor in ocorrencias:
                ocorrencias[valor] += 1
            else:
                ocorrencias[valor] = 1
    return ocorrencias

